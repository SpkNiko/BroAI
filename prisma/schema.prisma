generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppMode {
  PROGRAMMER
  CHAT
  LEARN
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id            String             @id @default(cuid())
  email         String             @unique
  name          String?
  passwordHash  String
  pfpUrl        String?
  language      String             @default("pl")
  theme         String             @default("dark")
  responseStyle String             @default("balanced")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  sessions      Session[]
  projects      Project[]
  memories      Memory[]
  conversations Conversation[]
  learning      LearningProgress[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@index([userId])
  @@index([expiresAt])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  mode        AppMode  @default(PROGRAMMER)
  engine      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  files CodeFile[]

  @@index([userId, updatedAt])
}

model CodeFile {
  id        String   @id @default(cuid())
  projectId String
  path      String
  content   String   @db.Text
  language  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(
    fields: [projectId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([projectId, path])
  @@index([projectId])
}

model Memory {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String   @db.Text
  category  String   @default("general")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([userId, key])
  @@index([userId, category])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String    @default("Nowa rozmowa")
  mode      AppMode   @default(CHAT)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  messages Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String       @db.Text
  provider       String?
  model          String?
  createdAt      DateTime     @default(now())

  conversation Conversation @relation(
    fields: [conversationId],
    references: [id],
    onDelete: Cascade
  )

  @@index([conversationId, createdAt])
}

model LearningProgress {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  level       Int      @default(0)
  score       Float    @default(0)
  streak      Int      @default(0)
  lastStudied DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([userId, subject])
}
